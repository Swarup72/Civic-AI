# CivicAI Analytics Lab — standalone prototype configuration.
# Copy to .env and adjust as needed. There is no database URI, no auth
# secret, and no production credential of any kind here — this project has
# none of those.

HOST=127.0.0.1
# Deliberately NOT 8000 (production), 8001 (civicai-vision-lab), or 8002
# (civicai-text-lab).
PORT=8003

RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
SAMPLE_DATA_DIR=data/sample
OUTPUTS_DIR=data/outputs
SAMPLE_DATASET_FILENAME=sample_complaints.csv

# Priority formula weights — independently designed for this prototype, NOT
# verified to match the production priority_service.py. See
# app/services/priority_analysis.py's own docstring.
WEIGHT_SEVERITY=0.40
WEIGHT_AFFECTED_USERS=0.20
WEIGHT_SUPPORT_COUNT=0.15
WEIGHT_LOCATION_SENSITIVITY=0.15
WEIGHT_DURATION=0.10

PRIORITY_CRITICAL_MIN=75
PRIORITY_HIGH_MIN=50
PRIORITY_MEDIUM_MIN=25

TREND_STABLE_BAND_PERCENT=10.0

# Optional-field defaults — documented in README.md too.
DEFAULT_SUPPORT_COUNT=0
DEFAULT_AFFECTED_USERS=10
DEFAULT_LOCATION_SENSITIVITY=Medium

MAX_UPLOAD_SIZE_MB=10
