# CivicAI Text Intelligence Lab — standalone prototype configuration.
# Copy to .env and adjust as needed. There is no database URI, no auth
# secret, and no production credential of any kind here — this project has
# none of those.

HOST=127.0.0.1
# Deliberately NOT 8000 (production backend) or 8001 (civicai-vision-lab).
PORT=8002

MODEL_DIR=models/trained
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
SAMPLE_CASES_DIR=data/sample_cases

# The WEAKEST of the three heads' confidence must meet this bar, or the
# pipeline uses the rule-based fallback instead of the ML result.
CONFIDENCE_THRESHOLD=0.45

TRAIN_RATIO=0.70
VAL_RATIO=0.15
TEST_RATIO=0.15
SPLIT_RANDOM_SEED=42

MAX_TEXT_LENGTH=5000
MAX_BATCH_SIZE=100
