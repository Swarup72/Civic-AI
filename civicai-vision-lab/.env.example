# CivicAI Vision Lab — standalone prototype configuration.
# Copy to .env and adjust as needed. There is no database URI, no auth
# secret, and no production credential of any kind here — this project has
# none of those.

HOST=127.0.0.1
# Deliberately NOT 8000 — the production CivicAI backend runs there.
PORT=8001

MODEL_DIR=models/pretrained
OUTPUT_DIR=data/outputs
SAMPLES_DIR=data/samples

MIN_RESOLUTION_WIDTH=300
MIN_RESOLUTION_HEIGHT=300
BLUR_VARIANCE_THRESHOLD=100.0
MIN_BRIGHTNESS=25.0
MAX_BRIGHTNESS=230.0

MAX_UPLOAD_SIZE_MB=8

ORB_MAX_FEATURES=1000
ORB_MIN_KEYPOINTS=8
ORB_MIN_GOOD_MATCHES=10
ORB_RATIO_THRESHOLD=0.75
ORB_SAME_SCENE_MATCH_SCORE=0.3
